{
  "name": "j-erp",
  "version": "1.0.0",
  "description": "J-ERP frontend build (React + TypeScript + Tailwind CSS)",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node tools/build-runtime.mjs",
